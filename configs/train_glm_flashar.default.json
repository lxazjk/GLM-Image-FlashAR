{
  "model_path": "./models/GLM-Image-Decoder",
  "pretok_glob": "./data/pretok/train_partfirst/*.tar",
  "save_dir": "./outputs/glm_flashar",
  "vle_subfolder": "vision_language_encoder",
  "processor_subfolder": "processor",
  "require_preview_tokens": true,
  "pretok_preflight_deep_check": true,
  "require_pretok_metadata": true,
  "target_h": 1024,
  "target_w": 1024,
  "vocab_size": 16512,
  "hidden_size": 4096,
  "codebook_size": 16384,
  "use_vertical_block": true,
  "vertical_layers": 4,
  "vertical_start_layer": -1,
  "vertical_head_warmup_steps": 1000,
  "optimizer": "adafactor",
  "lr": 5e-05,
  "backbone_lr": 5e-06,
  "backbone_lr_factor": 0.1,
  "weight_decay": 0.0,
  "adam_beta1": 0.9,
  "adam_beta2": 0.95,
  "grad_clip": 1.0,
  "grad_accum_steps": 1,
  "batch_size": 1,
  "num_workers": 4,
  "shuffle_buffer_size": 512,
  "epochs": 1000,
  "max_steps": 12000,
  "seed": 1234,
  "shuffle": true,
  "lr_scheduler": "cosine",
  "lr_min_factor": 0.05,
  "phase1_flat_steps": 200,
  "phase2_flat_steps": 500,
  "phase2_lr_factor": 0.1,
  "aux_loss_h_weight": 0.0,
  "aux_loss_v_weight": 0.05,
  "gate_collapse_weight": 0.0,
  "chunked_loss": false,
  "train_backbone": true,
  "gradient_checkpointing": true,
  "dtype": "bf16",
  "fsdp_use_orig_params": true,
  "fsdp_cpu_offload": false,
  "fsdp_no_sync": false,
  "log_every_steps": 25,
  "save_every_steps": 2000
}
